# Atlas Frontend — Environment Variables
# Copy this file to .env.local (never commit .env.local — it is gitignored)

# Base URL of the backend API, including /api/v1.
# Must match NEXT_PUBLIC_API_BASE_URL in the root .env / .env.example.
# P5-T2 reconciliation: renamed from NEXT_PUBLIC_API_URL to match root convention.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Application display name (used in page titles, branding)
NEXT_PUBLIC_APP_NAME=Atlas

# Environment identifier (development | staging | production)
NEXT_PUBLIC_APP_ENV=development
