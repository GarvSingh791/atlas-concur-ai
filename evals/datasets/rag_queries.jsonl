{"id": "rag_air_cabin_business_eligibility", "query": "When is business class permitted on a long flight over ten hours and when is premium economy allowed between six and ten hours duration", "gold_clause_refs": ["AIR-CABIN"], "expect": "grounded", "tags": ["AIR-CABIN", "single-clause", "paraphrase"]}
