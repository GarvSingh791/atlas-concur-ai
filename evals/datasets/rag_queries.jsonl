# RAG retrieval golden cases. gold_clause_refs = ground-truth clause refs that SHOULD
# be retrieved in the top-k. expect=grounded (clauses retrievable) | silent (off-topic).
# Queries are token-rich (8+ content tokens overlapping the clause text) for the local
# salted-hash embedder. Tokens are lexically matched against database/seeds/policy_content.py
# CLAUSES chunk_text; grounded queries lift content tokens from the target clause(s), silent
# queries deliberately avoid all clause vocabulary so similarity stays below the 0.20 gate.
#
# Coverage: >=1 grounded query per clause (AIR-CABIN, AIR-PREF, HOTEL-CAP, HOTEL-PREF,
# MEALS-PD, GROUND-CLASS, RECEIPT-REQ, SUSTAIN), multi-clause queries, paraphrase/variant
# grounded queries, and off-topic silent queries. ~28 cases total.
#
# --- SAMPLE set (3 cases, preserved from the seeded harness) ---
{"id": "rag_hotel_cap_tier1", "query": "What is the nightly hotel rate cap for Tier-1 cities like New York San Francisco London Tokyo Paris Zurich excluding taxes", "gold_clause_refs": ["HOTEL-CAP"], "expect": "grounded", "tags": ["HOTEL-CAP", "single-clause"]}
{"id": "rag_air_cabin_and_preferred_carriers", "query": "Which cabin class is permitted by flight duration and which preferred air carriers United Delta Lufthansa must travelers book", "gold_clause_refs": ["AIR-CABIN", "AIR-PREF"], "expect": "grounded", "tags": ["AIR-CABIN", "AIR-PREF", "multi-clause"]}
{"id": "rag_offtopic_silent", "query": "How do I reset my email password and configure two factor authentication on my corporate laptop device", "gold_clause_refs": [], "expect": "silent", "tags": ["off-topic", "silent"]}
