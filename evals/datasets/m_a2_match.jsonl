# M-A2 smart-match golden cases. gold.matches lists the linkage each MatchCandidate
# represents; unmatched_* list receipt/txn ids that surface as singletons.
# smart_match emits ONE candidate per active receipt (+ optional dup txn / segment) and
# ONE per active txn not consumed as a duplicate; itinerary segments are never surfaced
# as standalone candidates. already_linked receipts / already_matched txns are filtered
# out entirely (no candidate, no idempotency markers in gold). Match rules (matching.py):
# amount +-0.01, currency case-insensitive, receipt<->txn date +-1 day, txn/receipt<->segment
# date in [start-1, end+1]; vendor token-containment is a tiebreaker only (NOT required for a
# duplicate). Segment link also requires segment_type<->expense_type category compatibility
# (flight:{airfare,flight,air}, hotel:{lodging,hotel,accommodation}, rail:{rail,train,
# ground_transport}, car:{car,ground_transport,rideshare,taxi}); expense_type=null => compatible.
# ~50-case corpus. The first 3 are the original SAMPLE set.
{"id": "m_a2_receipt_txn_duplicate", "tags": ["duplicate", "receipt+card_txn", "happy-path"], "ingest": {"receipts": [{"receipt_id": "r-dup-1", "amount": 250.0, "currency": "USD", "date": "2026-03-10", "vendor": "Hilton Chicago", "location": "Chicago", "expense_type": "lodging"}], "card_txns": [{"txn_id": "t-dup-1", "amount": 250.0, "currency": "USD", "merchant": "HILTON HOTELS", "txn_date": "2026-03-10", "last_four": "1234"}], "segments": [], "trip_id": null, "unprocessed_receipts": []}, "gold": {"matches": [{"receipt_id": "r-dup-1", "card_txn_id": "t-dup-1", "is_duplicate": true}], "unmatched_receipts": [], "unmatched_card_txns": []}}
