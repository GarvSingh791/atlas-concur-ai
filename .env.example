# =============================================================================
# ATLAS — AI Travel & Expense Copilot
# Environment Variable Reference
# =============================================================================
#
# Copy this file to `.env` and fill in your values before running the app.
# NEVER commit `.env` to source control.
# All secrets and credentials MUST live here — never hardcoded in source.
# Every variable below is required unless marked [optional].
#
# Design references:
#   docs/TECHNICAL_DESIGN.md    — provider abstractions, security model, API design
#   docs/MASTER_EXECUTION_PLAN.md — phase-by-phase build playbook
#   docs/DATABASE_SCHEMA.md     — data model, pgvector, tenancy seam
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION / RUNTIME
# -----------------------------------------------------------------------------

# Human-readable name for the application (used in /health and API metadata).
APP_NAME=Atlas

# Application version string reported in /health and API metadata.
APP_VERSION=0.1.0

# Git commit of the running release, reported as "commit" by GET /health.
# Leave unset: Render injects RENDER_GIT_COMMIT automatically on staging, and
# local runs report "local". Set APP_COMMIT_SHA only to override.
# APP_COMMIT_SHA=

# Runtime environment. Controls debug mode, log verbosity, and error exposure.
# Values: development | staging | production
APP_ENV=development

# Set to false in production — disables stack traces and detailed error responses.
APP_DEBUG=true

# Logging severity. Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log output format. "json" is required for structured log pipelines (TECHNICAL_DESIGN §Logging).
# Values: json | text
LOG_FORMAT=json


# -----------------------------------------------------------------------------
# API SERVER (FastAPI / backend)
# -----------------------------------------------------------------------------

# Host the FastAPI app binds to inside the container.
API_HOST=0.0.0.0

# Port the FastAPI app listens on.
API_PORT=8000

# URL prefix for all versioned API routes.
API_V1_PREFIX=/api/v1

# Default and maximum page size for paginated list endpoints.
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100


# -----------------------------------------------------------------------------
# FRONTEND (Next.js)
# -----------------------------------------------------------------------------

# Public env var consumed by Next.js (NEXT_PUBLIC_ prefix exposes it to the browser).
# Points to the FastAPI /api/v1 base. Must NOT contain secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# NOTE: other frontend-local vars (NEXT_PUBLIC_APP_NAME, NEXT_PUBLIC_APP_ENV) live in
# frontend/.env.local.example, not in this backend template. NEXT_PUBLIC_* values are
# inlined at `next build` (not read at runtime), so use the browser-reachable URL
# (localhost), never the in-cluster service name.


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated list of origins allowed to call the API.
# In production, restrict to the exact frontend domain(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Whether the API accepts cookies/credentials in cross-origin requests.
CORS_ALLOW_CREDENTIALS=true


# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL + pgvector
# (TECHNICAL_DESIGN §Database Architecture; DATABASE_SCHEMA.md §Database Choice)
# -----------------------------------------------------------------------------

# Full SQLAlchemy connection string. Used by the backend at startup.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://atlas_user:change-me@localhost:5432/atlas_db

# Individual components used by docker-compose to initialise the database service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlas_db
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=change-me

# Docker note: docker-compose builds the in-container DATABASE_URL from these
# POSTGRES_* values using the service hostname `postgres` (not localhost), and
# sources MinIO's MINIO_ROOT_USER / MINIO_ROOT_PASSWORD from
# STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY below. Run compose from the
# repo root with `--env-file .env` so ${VAR} interpolation resolves.

# NOTE: the pgcrypto and vector (pgvector) extensions are created by Alembic
# migration 0001, not by an env var.


# -----------------------------------------------------------------------------
# AUTHENTICATION — JWT
# (TECHNICAL_DESIGN §Authentication; Security Rule: enforce RBAC server-side)
# -----------------------------------------------------------------------------

# Secret used to sign JWT tokens. Use a cryptographically random 64-char string.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-use-a-64-char-random-hex-string

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Short-lived access token lifetime (minutes). Keep short for security.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime (days).
REFRESH_TOKEN_EXPIRE_DAYS=7

# bcrypt work factor for password hashing. 12 is a strong production default.
PASSWORD_HASH_ROUNDS=12


# -----------------------------------------------------------------------------
# RATE LIMITING (phase 11 — backend/app/core/rate_limit.py)
# In-process limiter: correct for ONE process (Render: one uvicorn worker, one
# instance). Rates are "<count>/<second|minute|hour|day>"; "day" quotas reset at
# 00:00 UTC, shorter windows slide. An invalid rate stops the app at startup.
# Over the limit -> HTTP 429, code RATE_LIMITED, retry_after_seconds + Retry-After.
# -----------------------------------------------------------------------------

# Master switch. Keep true anywhere reachable from the internet. The pytest
# suite and the CI E2E lane set it to false (many logins from one IP).
RATE_LIMIT_ENABLED=true

# Reverse proxies in front of the app that APPEND to X-Forwarded-For. 0 = ignore
# the header (local / docker compose); Render = 1. Setting this higher than the
# real chain lets clients pick their own identity — never guess high.
TRUSTED_PROXY_COUNT=0

# Max tracked counters per table (memory bound). A live counter is never
# evicted: when there is no room, a new identity is counted in one of
# clamp(MAX_KEYS / 200, 16, 4096) hashed per-network overflow buckets (250 at
# the default) — never one global bucket a flood could exhaust for everyone.
RATE_LIMIT_MAX_KEYS=50000
# Counters one client address (IPv6: one /64) may own before its new
# identities (e.g. sprayed emails) share one overflow bucket / backoff row.
# One IPv6 /48 may own 16x this many (1024 at the default).
RATE_LIMIT_MAX_KEYS_PER_IP=64

# Login / refresh — per client IP, and per (IP, email).
RATE_LIMIT_LOGIN_PER_IP=30/minute
RATE_LIMIT_LOGIN_PER_IP_EMAIL=10/minute
RATE_LIMIT_REFRESH_PER_IP=120/minute

# Failed-login backoff per (client IP, email, "org code given"), hashed; same
# answer whether or not the account or org code exists (the code VALUE is not
# part of the key, so varying it cannot mint fresh attempts): after THRESHOLD
# failures within WINDOW seconds every further attempt FROM THAT ADDRESS waits
# BASE * 2^(failures - THRESHOLD) seconds, capped at MAX. A success resets that
# entry. Other addresses are never blocked by someone else's failures.
LOGIN_BACKOFF_THRESHOLD=5
LOGIN_BACKOFF_BASE_SECONDS=30
LOGIN_BACKOFF_MAX_SECONDS=900
LOGIN_BACKOFF_WINDOW_SECONDS=900
# Distributed-attack guard: failed logins for ONE email from ANY address within
# a sliding hour. At this count one WARNING is logged (hashed identity) and
# every further FAILING attempt locks its own address for
# BASE * 2^(count - ALERT) seconds (capped at MAX). A correct password from an
# address that has not itself failed always succeeds. GET /ops/rate-limits ->
# login_email_failure_alert.
LOGIN_EMAIL_FAILURE_ALERT=50

# User administration (POST/PATCH /users, deactivate/reactivate) — per admin.
RATE_LIMIT_USER_ADMIN_PER_USER=30/minute
RATE_LIMIT_USER_ADMIN_DAILY_PER_USER=300/day

# AI spend (policy Q&A / evaluate, assistant + planner turns, rule authoring).
RATE_LIMIT_AI_PER_USER=60/hour
RATE_LIMIT_AI_DAILY_PER_USER=300/day
RATE_LIMIT_AI_DAILY_PER_ORG=2000/day

# Receipt upload (OCR + storage) — per user.
RATE_LIMIT_RECEIPT_PER_USER=10/minute
RATE_LIMIT_RECEIPT_DAILY_PER_USER=100/day

# Safety net for every other /api/v1 request (per user, else per IP).
RATE_LIMIT_DEFAULT=300/minute

# Where the counters live (phase 12 follow-up; docs/runbooks/rate-limit-redis.md).
# memory (default) = in-process: right for ONE worker on ONE instance, resets on
# every restart. redis = shared by every worker / instance (atomic Lua script,
# Redis TIME, hashed keys with TTLs). Local: docker compose --profile redis up.
RATE_LIMIT_STORE=memory
# redis:// or rediss:// URL. A SECRET when it carries a password (Render: sync:
# false). Compose service: redis://redis:6379/0. Empty = no Redis.
REDIS_URL=
# Per-call connect + command timeout (ms); slower counts as Redis being down.
RATE_LIMIT_REDIS_TIMEOUT_MS=50
# Namespace of every key the limiter writes.
RATE_LIMIT_REDIS_PREFIX=atlas:rl:
# Redis down: memory = serve from a per-process fallback store (limits stay on,
# per instance); closed = 503 RATE_LIMIT_UNAVAILABLE on rate-limited routes;
# open = admit. Counted on GET /ops/rate-limits; Redis is retried automatically.
RATE_LIMIT_REDIS_FAILURE=memory
# Account recovery (phase 12 follow-ups). Checked before any database read, so a
# throttled answer is the same for every account.
# POST /auth/forgot-password: per (IP, email) and per IP.
RATE_LIMIT_FORGOT_PER_IP_EMAIL=5/hour
RATE_LIMIT_FORGOT_PER_IP=20/hour
# POST /auth/reset-password | accept-invite | verify-email | change-password: per IP.
RATE_LIMIT_ACCOUNT_LINK_PER_IP=10/minute
# GET /auth/invite/{token} (the accept page's invitation preview): per IP.
RATE_LIMIT_INVITE_PEEK_PER_IP=30/minute
# POST /users/invite (+ resend / revoke): per finance admin.
RATE_LIMIT_INVITE_PER_USER=30/hour
# POST /auth/send-verification: per signed-in user.
RATE_LIMIT_SEND_VERIFICATION_PER_USER=5/hour


# -----------------------------------------------------------------------------
# LLM PROVIDER
# (TECHNICAL_DESIGN §AI System Design — FR-A6: model-provider abstraction)
#
# All agents call the model through one provider interface so the underlying
# LLM is swappable without code changes. Rule 6: LLM must always be optional —
# deterministic path must work independently.
# -----------------------------------------------------------------------------

# Provider name. Values: local | anthropic | openrouter
# "local" runs the deterministic path with no LLM configured (Rule 6: LLM is optional).
LLM_PROVIDER=local  # options: local, anthropic, openrouter

# Provider API key. Keep secret.
LLM_API_KEY=your-llm-api-key-here

# Model identifier for the chosen provider.
# openai:     gpt-4o | gpt-4o-mini
# anthropic:  claude-opus-4-8 | claude-sonnet-4-6 | claude-haiku-4-5
# google:     gemini-2.0-flash | gemini-1.5-pro
# openrouter: google/gemini-2.5-flash | google/gemini-2.5-flash-lite
LLM_MODEL=claude-sonnet-4-6

# Optional override for the provider base URL (local/proxy setups).
# Leave empty to use the provider's default endpoint.
# openrouter: defaults to https://openrouter.ai/api/v1 when left empty.
LLM_BASE_URL=

# Sampling temperature. Lower = more deterministic (use ~0.2 for policy decisions).
LLM_TEMPERATURE=0.3

# Temperature of the policy Q&A critic whose SUPPORTED / UNSUPPORTED verdict gates
# a provisional answer (C7R). 0.0 = same answer, same verdict. Range 0.0-2.0.
POLICY_QA_CRITIC_TEMPERATURE=0.0

# Maximum output tokens per invocation.
LLM_MAX_TOKENS=4096

# Per-request timeout (seconds). Prevents hung AI calls from blocking the API.
LLM_TIMEOUT_SECONDS=30

# Number of retries on transient provider errors before failing.
LLM_RETRY_ATTEMPTS=3

# Reasoning-token budget for thinking models (openrouter). 0 disables thinking —
# narratives stay cheap and deterministic. Raise only for hard reasoning tasks.
LLM_THINKING_BUDGET=0

# Fallback model tried once when the primary model errors (openrouter only).
LLM_MODEL_FALLBACK=google/gemini-2.5-flash-lite


# -----------------------------------------------------------------------------
# EMBEDDINGS PROVIDER
# (TECHNICAL_DESIGN §Shared AI infrastructure; DATABASE_SCHEMA.md §policy_embeddings)
#
# Powers policy RAG retrieval. EMBEDDINGS_DIMENSIONS must match the vector
# column type in the policy_embeddings table (e.g. VECTOR(1536)).
# -----------------------------------------------------------------------------

# Provider for text embeddings. Values: openai | cohere | huggingface | local
EMBEDDINGS_PROVIDER=local  # options: local, openai

# Provider API key. Keep secret.
EMBEDDINGS_API_KEY=your-embeddings-api-key-here

# Model identifier for the chosen provider.
# openai:       text-embedding-3-small (1536D) | text-embedding-3-large (3072D)
# cohere:       embed-english-v3.0 (1024D)
# huggingface:  sentence-transformers/all-MiniLM-L6-v2 (384D)
EMBEDDINGS_MODEL=text-embedding-3-small

# Embedding dimensionality. MUST match the VECTOR(n) column in policy_embeddings.
EMBEDDINGS_DIMENSIONS=1536

# Optional override base URL for local/proxy embedding endpoints.
EMBEDDINGS_BASE_URL=

# Number of texts to embed per API call (batch efficiency).
EMBEDDINGS_BATCH_SIZE=100


# -----------------------------------------------------------------------------
# OCR PROVIDER
# (TECHNICAL_DESIGN §Receipt Analysis Agent — deterministic extraction core)
#
# Used by the receipt pipeline for structured field extraction from images.
# Low-confidence fields (below OCR_CONFIDENCE_THRESHOLD) are routed to the
# AI gap-fill agent path. The deterministic core works with LLM_PROVIDER=local (no LLM).
# -----------------------------------------------------------------------------

# Provider for OCR / document extraction.
# Values: local | openrouter  (anthropic was removed; it now fails at startup)
OCR_PROVIDER=local  # options: local, openrouter

# Provider API key. Keep secret.
OCR_API_KEY=your-ocr-api-key-here

# Optional override base URL (self-hosted OCR).
OCR_BASE_URL=

# Model identifier used when OCR_PROVIDER=openrouter.
OCR_MODEL=google/gemini-2.5-flash

# Per-request timeout (seconds).
OCR_TIMEOUT_SECONDS=20

# Maximum receipt image size accepted (megabytes).
OCR_MAX_FILE_SIZE_MB=10

# Fields with confidence below this threshold are routed to the AI gap-fill agent.
# Range: 0.0–1.0. 0.85 is a strong default.
OCR_CONFIDENCE_THRESHOLD=0.85


# -----------------------------------------------------------------------------
# OBJECT STORAGE — S3-Compatible
# (TECHNICAL_DESIGN §Storage strategy; NFR-SEC4: short-lived scoped URLs)
#
# Receipt images and attachments are stored in object storage.
# The database stores only the reference/URL — never the binary blob.
# Images are served via short-lived pre-signed URLs (never public links).
# -----------------------------------------------------------------------------

# Storage backend. Values: local | minio. Any S3-compatible service (incl. Cloudflare R2)
# is selected with "minio" plus its STORAGE_ENDPOINT_URL; there is no "r2"/"s3" value.
STORAGE_PROVIDER=local  # options: local, minio

# Local filesystem base directory for the "local" storage provider (dev/test only).
# Leave empty to use tempfile.gettempdir()/atlas-storage automatically.
STORAGE_LOCAL_PATH=

# S3-compatible endpoint URL. For AWS S3, leave empty.
# For MinIO (local dev): http://localhost:9000
STORAGE_ENDPOINT_URL=http://localhost:9000

# Optional: the endpoint a BROWSER uses for receipt-image links. Presigned URLs are
# signed for this host (SigV4 signs the host), while uploads/downloads stay on
# STORAGE_ENDPOINT_URL. Leave empty unless the API reaches storage via an internal
# hostname (docker-compose sets http://localhost:9000 while the API uses minio:9000).
# Leave empty for Cloudflare R2 / AWS S3 (staging).
STORAGE_PUBLIC_ENDPOINT_URL=

# AWS region (or region for hosted S3-compatible services).
STORAGE_REGION=us-east-1

# Dedicated bucket for receipt images and attachments.
STORAGE_BUCKET=atlas-receipts-dev

# Credentials. Keep secret. In Docker these become MinIO's root user/password,
# so STORAGE_SECRET_ACCESS_KEY MUST be >= 8 characters (MinIO refuses to start
# otherwise).
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=change-me

# Use path-style URLs — required for MinIO and some S3-compatible services.
# Set to false for AWS S3.
STORAGE_FORCE_PATH_STYLE=true

# Lifetime of pre-signed download URLs (seconds). Short = more secure (NFR-SEC4).
STORAGE_PRESIGNED_URL_EXPIRY_SECONDS=300


# -----------------------------------------------------------------------------
# REQUEST BODY + UPLOAD LIMITS (phase 11 — public-demo security)
# -----------------------------------------------------------------------------
# All optional; the values below are the code defaults.  Every request body is
# capped (413 PAYLOAD_TOO_LARGE) by Content-Length AND by counting the streamed
# bytes, so a missing or lying header cannot bypass it.

# JSON / form request bodies (bytes). 1 MiB.
MAX_REQUEST_BODY_BYTES=1048576

# Receipt file size (bytes) for POST /receipts. 10 MiB. The route adds a
# 64 KiB multipart allowance at the body layer and re-checks the file exactly.
MAX_UPLOAD_BYTES=10485760

# Decompression-bomb guards, read from the image header before decoding:
# maximum width x height (pixels) and maximum width or height.
UPLOAD_MAX_IMAGE_PIXELS=40000000
UPLOAD_MAX_IMAGE_DIMENSION=12000

# PDF receipts (phase 12, rasterise-only): a PDF (at most MAX_UPLOAD_BYTES) is
# rendered by PDFium in a short-lived child process into ONE PNG of its first
# UPLOAD_PDF_MAX_PAGES pages stacked vertically; only that PNG is stored,
# served and sent to OCR (the PDF never is).  A page larger than
# UPLOAD_PDF_MAX_PAGE_INCHES on either side is refused (422) before rendering;
# a page is rendered at most UPLOAD_PDF_MAX_SIDE_PX on its longest side (and at
# most 200 DPI).  The child is killed after UPLOAD_PDF_RENDER_TIMEOUT_SECONDS
# of wall clock or UPLOAD_PDF_RENDER_CPU_SECONDS of CPU, and may grow its
# address space by at most UPLOAD_PDF_RENDER_MEMORY_BYTES; any failure is a
# 422 "could not read this PDF", never a 500.  One render runs at a time per
# process; an upload waits for it at most UPLOAD_PDF_QUEUE_WAIT_SECONDS, then
# gets a retryable 503 PDF_RENDERER_BUSY with Retry-After (no unbounded queue).
UPLOAD_PDF_MAX_PAGES=3
UPLOAD_PDF_MAX_PAGE_INCHES=20
UPLOAD_PDF_MAX_SIDE_PX=2000
UPLOAD_PDF_RENDER_TIMEOUT_SECONDS=10
UPLOAD_PDF_RENDER_CPU_SECONDS=10
UPLOAD_PDF_RENDER_MEMORY_BYTES=268435456
UPLOAD_PDF_QUEUE_WAIT_SECONDS=3

# Storage quotas, enforced at upload (409 UPLOAD_QUOTA_EXCEEDED). Deleting a
# receipt frees its share. Per user: 200 files / 200 MiB. Per org: 5000 / 2 GiB.
UPLOAD_QUOTA_USER_FILES=200
UPLOAD_QUOTA_USER_BYTES=209715200
UPLOAD_QUOTA_ORG_FILES=5000
UPLOAD_QUOTA_ORG_BYTES=2147483648


# -----------------------------------------------------------------------------
# AI BEHAVIOUR — Guardrails, Retrieval, Reflection
# (TECHNICAL_DESIGN §AI observability — FR-A5; §Reflection/critic — grounding)
#
# These settings govern the intelligence plane (ai_agents/).
# Every AI invocation writes a complete row to ai_decision_logs.
# -----------------------------------------------------------------------------

# Number of policy chunks returned per RAG retrieval query (top-K).
# Higher = more context for the policy agent; lower = faster.
RETRIEVAL_TOP_K=5

# Minimum cosine similarity for a retrieved chunk to count as grounded evidence.
# R3-T2: this is now the FALLBACK gate — used only when the calibrated reranker score is
# unavailable (rerank not applied, no params for the provider, or no τ* artifact).  The
# PRIMARY gate is the data-derived τ* in ai_agents/rag/abstention_threshold.json.
# Default 0.20 calibrated for LocalEmbeddingsProvider (dev, feature-hashing).  Range: 0.0–1.0.
RETRIEVAL_SIMILARITY_THRESHOLD=0.20

# R3-T1/T2: target risk r* for the calibrated abstention gate — the precision floor on
# answered queries (0.05 ⇒ ≥95% precision-on-answered).  Set THIS, not τ* directly; τ* is
# recomputed from r* by `make threshold-local` / `make threshold-hf`.  Range: 0.0–1.0.
ABSTENTION_TARGET_RISK=0.05

# Minimum classification confidence for the orchestrator to take the deterministic
# (no-LLM) path.  Tasks with confidence >= threshold AND requires_reasoning=False
# are served without an agent LLM call; all others are dispatched to an agent.
# Range: 0.0–1.0.  Clear context_type matches score 0.95; unknown/general score 0.40.
# Lower this value to route more tasks deterministically (faster, cheaper, less capable).
ROUTING_CONFIDENCE_THRESHOLD=0.75

# RAG (R1 hybrid retrieval, R4-R6 retrieval/grounding toggles). Defaults are the in-code
# defaults; the flags below are OFF by default so the default/CI path stays hermetic.

# Reciprocal Rank Fusion constant k (dense + sparse fusion).
RRF_K=60

# HyDE (hypothetical-document query expansion): second retrieval pass for weak first-pass
# hits. Costs one extra LLM call; a no-op under LLM_PROVIDER=local.
HYDE_ENABLED=false

# Upper bound of the HyDE weak band (max-dense cosine; local-embedder scale — recalibrate
# per embedder before enabling in prod). Inert while HYDE_ENABLED=false.
HYDE_WEAK_BAND_UPPER=0.30

# Minimum fraction of an answer sentence's content tokens that must appear in the chunk(s)
# it cites (deterministic token-overlap entailment gate). Range: 0.0-1.0.
NLI_ENTAILMENT_THRESHOLD=0.55

# Prepend situating context prefixes to chunks at ingest/embed time (Contextual Retrieval).
# Changing this requires re-indexing the corpus.
RAG_CONTEXTUAL_PREFIXES=false

# -----------------------------------------------------------------------------
# RERANK PROVIDER  (R2-T1 — cross-encoder precision stage)
# (TECHNICAL_DESIGN §AI System Design — FR-A6: model-provider abstraction)
#
# After dense+sparse+RRF (R1) recall, a cross-encoder reranker rescores the fused
# top-N candidates with joint query<->document attention and reorders them down to a
# high-precision top-k.  Like every provider, it is swappable and defaults to a
# deterministic local stand-in so the default/CI path is hermetic (no key, no network).
# -----------------------------------------------------------------------------

# Provider name. Values: local | huggingface | cohere | novita
# local       = deterministic lexical stand-in (RRF-anchored; CI-safe, no key, no network).
# huggingface = hosted BAAI/bge-reranker-v2-m3 cross-encoder over httpx (free Inference API).
# cohere      = hosted Cohere Rerank cross-encoder over httpx (swap-target skeleton).
# novita      = hosted Novita rerank over httpx (uses RERANK_API_KEY).
RERANK_PROVIDER=local  # options: local, huggingface, cohere, novita

# Cohere/Novita API key. Keep secret. REQUIRED only when RERANK_PROVIDER=cohere|novita.
RERANK_API_KEY=

# HuggingFace Inference token (read scope is enough). REQUIRED only when
# RERANK_PROVIDER=huggingface. Keep secret; never commit a real value.
# Create one at https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Model identifier for the chosen provider.
# huggingface: BAAI/bge-reranker-v2-m3   |   cohere: rerank-v3.5 | rerank-english-v3.0
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Optional override for the provider base URL (proxy / live-test setups). Leave at the
# default for huggingface; set "" to fall back to the Cohere default (https://api.cohere.com).
RERANK_BASE_URL=https://router.huggingface.co/hf-inference/models

# Final precision cutoff handed to the generator (recommended 5-8). The pipeline never
# truncates below the caller's requested top_k, so recall@k measurement is preserved.
RERANK_TOP_K=6

# Max RRF candidates rescored in the single batched rerank call (research §5.3 latency cap).
RERANK_CANDIDATE_CAP=50

# Per-request timeout (seconds) for the production reranker; one retry on a transient error.
RERANK_TIMEOUT_SECONDS=10

# R3-T4 — Blameless abstention escalation targets (shown when Atlas abstains).
# Generic defaults ship in code; populate from your policy corpus CONT-01/02 at onboarding.
# Helios Dynamics demo-corpus fixtures: Travel Desk travel@heliosdynamics.com / +1-800-555-0123;
# Finance/AP expenses@heliosdynamics.com; Compliance compliance@heliosdynamics.com.
ESCALATION_CONTACT_PRIMARY=your team lead
ESCALATION_CONTACT_SECONDARY=Travel Desk


# -----------------------------------------------------------------------------
# ORGANISATION
# (TECHNICAL_DESIGN §Authentication — NFR-S4: tenant isolation can be switched on)
#
# All business tables carry organization_id even in the single-tenant build.
# -----------------------------------------------------------------------------

# Human-readable organisation name (used by the policy agent when composing answers).
ORGANIZATION_NAME=Acme Corp


# -----------------------------------------------------------------------------
# SEED / DEVELOPMENT
# (MASTER_EXECUTION_PLAN §Phase 3-T5 — seed scripts for dev/test)
# -----------------------------------------------------------------------------

# Run database seed scripts on backend startup (dev only — NEVER in production).
SEED_ON_STARTUP=false

# Elapsed-trip sweep — a boot repair (runs when SEED_ON_STARTUP is true or
# policy_corpus) that marks APPROVED trips whose end date is more than
# ELAPSED_TRIP_GRACE_DAYS in the past as completed (audited, actor = system).
#   on      complete them (default; also when unset or empty)
#   dry-run log which trips WOULD be completed (trip id, end date, owner id only)
#           and write nothing — preview on a live database first
#   off     skip the step
# Any other value is treated as off, with a warning. So is a cap below 1 or a
# negative grace. See docs/runbooks/elapsed-trip-sweep.md.
ELAPSED_TRIP_SWEEP=on
# At most this many trips per run (oldest end date first; the rest next boot).
ELAPSED_TRIP_SWEEP_MAX=500
# Days after a trip's end date before the sweep completes it.
ELAPSED_TRIP_GRACE_DAYS=1

# Default password for seeded demo users. Change this. NEVER use in production.
SEED_DEFAULT_PASSWORD=change-me-seed-password

# ---- Public demo (phase 11; backend/app/core/demo.py) -----------------------
# true: the five seeded @atlas-demo.internal accounts of "Atlas Demo Corp" cannot
# be edited or deactivated (403 DEMO_ACCOUNT_PROTECTED, audited) and the seeded
# policy rules cannot be archived. Off by default; the owner decides.
DEMO_MODE=false
# Unset = follows DEMO_MODE. "false" lifts only the seeded-rule archive guard.
# DEMO_RESTRICT_DESTRUCTIVE=

# ---- Scheduled demo reset (phase 12; backend/app/core/demo_reset_scheduler.py)
# The backend resets "Atlas Demo Corp" to the seed baseline on a schedule. OFF by
# default. It runs ONLY when ALL of these hold:
#   DEMO_RESET_SCHEDULE is interval, DEMO_MODE is true, and the variable
#   DEMO_RESET_ENABLED is "true" in the PROCESS environment (the reset tool reads
#   it from the environment only, never from this file; set it in the Render
#   dashboard), and exactly one organisation is named "Atlas Demo Corp".
# An invalid value disables the schedule with a startup warning.
# See docs/runbooks/demo-reset.md.
DEMO_RESET_SCHEDULE=off
# Whole hours between resets (>= 1).
DEMO_RESET_INTERVAL_HOURS=24
# Optional 0-23: reset at the first opportunity after HH:00 UTC, once per interval.
# DEMO_RESET_AT_UTC_HOUR=
# ---- Email + account recovery (phase 12 follow-ups) -------------------------
# Password reset, invitations and email verification send one-time links.
#   console (default): NOTHING is delivered. One masked line is logged per
#     message ("email not delivered: provider=console purpose=reset
#     to=a***@d***.com"), never the link. Invitations then show their link ONCE
#     to the inviting admin, to hand over by hand.
#   smtp: delivered through SMTP_HOST (needs SMTP_HOST and EMAIL_FROM).
#   off:  nothing delivered, nothing logged per message.
EMAIL_PROVIDER=console
# Sender, e.g. "Atlas <no-reply@your-domain.example>".
EMAIL_FROM=
SMTP_HOST=
# 587 = STARTTLS, 465 = implicit TLS (both when SMTP_USE_TLS=true).
SMTP_PORT=587
SMTP_USERNAME=
# Secret: set it in the provider dashboard, never commit it.
SMTP_PASSWORD=
# false = plain SMTP, for a local relay / test sink only.
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
# The FRONTEND origin every emailed link is built from (never a request's Host
# header). https is required on staging and production (startup refuses
# otherwise); development may use http.
APP_BASE_URL=http://localhost:3000
# Link lifetimes.
AUTH_RESET_LINK_TTL_MINUTES=30
AUTH_INVITE_LINK_TTL_HOURS=168
AUTH_VERIFY_LINK_TTL_HOURS=24
